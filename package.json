{
  "name": "react-dev",
  "version": "1.0.0",
  "private": true,
  "license": "CC",
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "dev": "next-remote-watch ./src/content",
    "build": "next build && node --experimental-modules ./scripts/downloadFonts.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format:source": "prettier --config .prettierrc --write \"{plugins,src}/**/*.{js,ts,jsx,tsx,css}\"",
    "nit:source": "prettier --config .prettierrc --list-different \"{plugins,src}/**/*.{js,ts,jsx,tsx,css}\"",
    "prettier": "yarn format:source",
    "prettier:diff": "yarn nit:source",
    "lint-heading-ids": "node scripts/headingIdLinter.js",
    "fix-headings": "node scripts/headingIdLinter.js --fix",
    "ci-check": "npm-run-all prettier:diff --parallel lint tsc lint-heading-ids rss",
    "tsc": "tsc --noEmit",
    "start": "next start",
    "postinstall": "is-ci || husky install .husky",
    "check-all": "npm-run-all prettier lint:fix tsc rss",
    "rss": "node scripts/generateRss.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.1",
    "@codemirror/lint": "^6.8.5",
    "@codesandbox/sandpack-client": "^2.19.8",
    "@codesandbox/sandpack-react": "2.13.5",
    "@docsearch/css": "^3.9.0",
    "@docsearch/react": "^3.9.0",
    "@headlessui/react": "^1.7.19",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.2.15",
    "body-scroll-lock": "^3.1.5",
    "classnames": "^2.5.1",
    "date-fns": "^2.30.0",
    "debounce": "^1.2.1",
    "esquery": "^1.6.0",
    "github-slugger": "^1.5.0",
    "next": "16.1.0-canary.31",
    "next-remote-watch": "^1.0.0",
    "parse-numeric-range": "^1.3.0",
    "react": "^19.1.0",
    "react-collapsed": "4.0.4",
    "react-dom": "^19.1.0",
    "remark-frontmatter": "^4.0.1",
    "remark-gfm": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@mdx-js/mdx": "^2.3.0",
    "@types/body-scroll-lock": "^2.6.2",
    "@types/classnames": "^2.3.4",
    "@types/debounce": "^1.2.4",
    "@types/github-slugger": "^1.3.0",
    "@types/mdx-js__react": "^1.5.8",
    "@types/node": "^14.18.63",
    "@types/parse-numeric-range": "^0.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "asyncro": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "babel-eslint": "~10.1.0",
    "babel-plugin-react-compiler": "19.0.0-beta-e552027-20250112",
    "eslint": "~7.32.0",
    "eslint-config-next": "16.1.0-canary.31",
    "eslint-config-react-app": "^5.2.1",
    "eslint-plugin-flowtype": "~4.7.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "eslint-plugin-react-hooks": "^0.0.0",
    "fs-extra": "^9.1.0",
    "globby": "^11.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "lint-staged": "^16.1.0",
    "mdast-util-to-string": "^1.1.0",
    "metro-cache": "0.72.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.5",
    "postcss-flexbugs-fixes": "4.2.1",
    "postcss-preset-env": "^6.7.2",
    "prettier": "^2.8.8",
    "reading-time": "^1.5.0",
    "remark": "^12.0.1",
    "remark-external-links": "^7.0.1",
    "remark-html": "^12.0.0",
    "remark-images": "^2.0.0",
    "remark-slug": "^7.0.1",
    "remark-unwrap-images": "^2.1.0",
    "retext": "^7.0.1",
    "retext-smartypants": "^4.0.0",
    "rss": "^1.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "unist-util-visit": "^2.0.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "engines": {
    "node": ">=16.8.0"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 10,
    "showDetails": true
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css}": "yarn prettier",
    "src/**/*.md": "yarn fix-headings"
  }
}
